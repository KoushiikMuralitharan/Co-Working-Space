# ============================================================
# .NET / ASP.NET Core
# ============================================================

# Generated files
Generated/
**/Generated/

# NuGet
*.nupkg
*.snupkg
packages/
**/packages/

# NuGet package cache
project.lock.json
project.fragment.lock.json

# ASP.NET Core local development certificates
**/https/
*.pfx

# Local launch settings
# Keep launchSettings.json tracked because it usually contains
# non-secret local development configuration.
# Uncomment only if you decide not to track it.
# **/Properties/launchSettings.json

# ============================================================
# Configuration / Secrets
# ============================================================

# Environment variables
.env
.env.*
!.env.example

# Local secrets
secrets.json
**/secrets.json

# User-specific ASP.NET configuration
appsettings.Local.json
**/appsettings.Local.json

# IMPORTANT:
# Do NOT ignore appsettings.json or appsettings.Development.json
# automatically. They can be tracked if they contain no secrets.
#
# Put real passwords / connection strings containing secrets in:
# - .NET User Secrets
# - environment variables
# - local configuration files

